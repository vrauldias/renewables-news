# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA faça commit do arquivo ".env" preenchido.

# --- Groq (filtro_ia.py) ---
GROQ_API_KEY=

# --- Microsoft Entra ID / MSAL (main.py e coleta_preferencias.py) ---
TENANT_ID=
CLIENT_ID=
CERT_THUMBPRINT=
# Caminho para o arquivo .pem com a chave privada do certificado (não versionado)
PRIVATE_KEY_FILE_PATH=private_key.pem

# --- Envio de e-mail via Microsoft Graph (main.py) ---
EMAIL_REMETENTE=
# Nome exibido no assunto do e-mail e no título/cabeçalho do boletim
NOME_BOLETIM=Radar de Combustíveis Renováveis
# Link exibido no rodapé do e-mail para o usuário alterar suas preferências
LINK_PREFERENCIAS=

# --- Microsoft List / SharePoint (coleta_preferencias.py) ---
# Ver docs/microsoft-list.md para montar a lista e o formulário do zero.
SHAREPOINT_SITE_URL=
SHAREPOINT_LIST_NAME=
# Nomes INTERNOS das colunas de escolha múltipla (podem diferir do nome exibido!)
SHAREPOINT_FIELD_CATEGORIES=CategoriasNoticias
SHAREPOINT_FIELD_LANGUAGES=EscolherLinguas
# Idioma assumido quando o usuário não escolhe nenhum
IDIOMA_PADRAO=Português
