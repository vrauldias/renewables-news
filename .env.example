# =============================================================================
# Radar de Combustíveis Renováveis — configuração
# Copie este arquivo para ".env" e preencha. NUNCA faça commit do ".env".
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PROVEDOR DE IA
# -----------------------------------------------------------------------------
# Escolha UM provedor. Valores aceitos:
#   groq | gemini | anthropic | openai | openrouter | deepseek | mistral |
#   azure-openai | ollama
LLM_PROVIDER=groq

# Preencha APENAS a chave do provedor escolhido (as demais podem ficar vazias).
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Azure OpenAI usa chave + endpoint próprios:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Ollama roda local e não precisa de chave (só do endereço do servidor):
OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# 2. MODELOS POR TAREFA
# -----------------------------------------------------------------------------
# Deixe em branco para usar o padrão do provedor (ver llm/provedores.py).
# A tarefa mais sensível à qualidade é o AGRUPAMENTO — se for economizar em
# algum lugar, economize na TRIAGEM, não aqui.
LLM_MODELO_TRIAGEM=
LLM_MODELO_AGRUPAMENTO=
LLM_MODELO_RESUMO=

# Esforço de raciocínio. Só tem efeito no provedor "anthropic"
# (low | medium | high | xhigh | max). Padrão: low para triagem/resumo,
# medium para agrupamento.
LLM_EFFORT_TRIAGEM=low
LLM_EFFORT_AGRUPAMENTO=medium
LLM_EFFORT_RESUMO=low

# Intervalo mínimo, em segundos, entre chamadas à API (controle de rate limit).
# No Gemini tier gratuito os *-flash-lite aguentam 15 RPM — o padrão de 1.0s
# (60 RPM) estoura isso; suba para 4-5 nesse caso.
LLM_INTERVALO_ENTRE_CHAMADAS=1.0
# Tentativas em caso de falha/rate limit.
LLM_MAX_TENTATIVAS=5

# -----------------------------------------------------------------------------
# 3. AGRUPAMENTO DE NOTÍCIAS (deduplicação entre portais)
# -----------------------------------------------------------------------------
# Limiar de similaridade para DOIS itens entrarem no mesmo bloco candidato.
# Mais baixo = mais candidatos vão para a IA decidir (mais caro, agrupa mais).
AGRUP_LIMIAR_BLOCO=0.22
# Similaridade a partir da qual dois itens são considerados o mesmo fato mesmo
# que a IA falhe (usado como rede de segurança / fallback offline).
AGRUP_LIMIAR_CERTEZA=0.62
# Tamanho máximo de um bloco enviado à IA de uma só vez.
AGRUP_MAX_ITENS_POR_BLOCO=25
# Deixe em 0 para desligar a etapa de IA e usar só o algoritmo determinístico.
AGRUP_USAR_IA=1

# Memória de eventos já enviados (evita repetir o mesmo fato dias depois).
HISTORICO_JANELA_DIAS=7
HISTORICO_LIMIAR=0.50
# suprimir = não reenvia | marcar = reenvia sinalizando "atualização"
HISTORICO_MODO=suprimir

# -----------------------------------------------------------------------------
# 4. MICROSOFT ENTRA ID / MSAL (envio de e-mail e leitura das preferências)
# -----------------------------------------------------------------------------
TENANT_ID=
CLIENT_ID=
CERT_THUMBPRINT=
PRIVATE_KEY_FILE_PATH=private_key.pem

# -----------------------------------------------------------------------------
# 5. BOLETIM
# -----------------------------------------------------------------------------
EMAIL_REMETENTE=
NOME_BOLETIM=Radar de Combustíveis Renováveis
LINK_PREFERENCIAS=
PERIODO_BUSCA=24h
IMAGEM_CABECALHO=header.png

# -----------------------------------------------------------------------------
# 6. FONTE DAS PREFERÊNCIAS
# -----------------------------------------------------------------------------
# sharepoint = lê de uma lista do Microsoft Lists
# arquivo    = usa um preferencias.json mantido à mão (ver preferencias.exemplo.json)
FONTE_PREFERENCIAS=sharepoint
SHAREPOINT_SITE_URL=
SHAREPOINT_LIST_NAME=
SHAREPOINT_FIELD_CATEGORIES=CategoriasNoticias
SHAREPOINT_FIELD_LANGUAGES=EscolherLinguas
IDIOMA_PADRAO=Português
